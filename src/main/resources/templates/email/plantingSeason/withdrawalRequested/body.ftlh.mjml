<!-- <#-- @ftlvariable name="" type="com.terraformation.backend.email.model.PlantingDateWithdrawalRequested" --> -->
<mjml>
    <mj-include path="../../head.ftlh.mjml"/>

    <mj-body>
        <mj-include path="../../logo.ftlh.mjml"/>

        <mj-section padding="0px">
            <mj-column mj-class="body-wrapper">
                <mj-text mj-class="text-body03">
                    ${strings("notification.plantingSeason.withdrawalRequested.email.body", plantingDate.toString(), plantingSeasonName)}
                </mj-text>

                <mj-button mj-class="btn-productive-primary-md" href="${withdrawalRequestsUrl}">
                    ${strings("notification.plantingSeason.withdrawalRequested.email.buttonLabel")}
                </mj-button>

                <mj-include path="../../manageSettings.ftlh.mjml"/>

                <mj-include path="../../footer.ftlh.mjml"/>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
