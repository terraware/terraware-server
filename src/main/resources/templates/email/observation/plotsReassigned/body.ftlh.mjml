<!-- <#-- @ftlvariable name="" type="com.terraformation.backend.email.model.ObservationPlotsReassigned" --> -->
<!-- <#setting date_format="full"> -->
<mjml>
    <mj-include path="../../head.ftlh.mjml"/>

    <mj-body>
        <mj-include path="../../logo.ftlh.mjml"/>

        <mj-section padding="0px">
            <mj-column mj-class="body-wrapper">
                <mj-text mj-class="text-body03">
                ${strings(stringsPrefix + ".email.body.1", plantingSiteName, startDateString)}
                </mj-text>

                <mj-button mj-class="btn-productive-primary-md"
                           href="${observationUrl?no_esc}">${strings("notification.observation.plotsReassigned.email.buttonLabel")}
                </mj-button>
                <mj-include path="../../manageSettings.ftlh.mjml"/>

                <mj-include path="../../footer.ftlh.mjml"/>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
